{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/image/(.*)", "dest": "/image/$1" },
    { "src": "/admin/(.*)", "dest": "/admin/$1" },
    { "src": "/client/(.*)", "dest": "/client/$1" },
    { "src": "/(.*)", "dest": "server.js" }
  ]
}
